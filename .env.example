# ===== CMC Agent Hub (L1) ====================================================
CMC_API_KEY=                       # https://pro.coinmarketcap.com/login (free tier OK)

# ===== Trust Wallet Agent Kit (L2) ==========================================
TWAK_API_BASE=                     # from https://portal.trustwallet.com
TWAK_API_KEY=

# ===== BNB AI Agent SDK / APEX (L3, BSC TESTNET ONLY) ========================
# DEDICATED throwaway wallet. NEVER a key that has ever touched mainnet funds.
PRIVATE_KEY=                       # first run only — SDK encrypts to ~/.bnbagent/wallets/
WALLET_PASSWORD=
NETWORK=bsc-testnet
STORAGE_PROVIDER=ipfs
STORAGE_API_KEY=                   # Pinata (or compatible) pinning JWT
SERVICE_PRICE=1000000000000000000  # 1 U token (18 decimals)

# ===== x402 keyless data path (optional) =====================================
X402_PRIVATE_KEY=                  # Base wallet holding a few USDC ($0.01/request)

# ===== LLM narrative polish (optional; numbers are never LLM-generated) ======
LLM_API_BASE=                      # any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== Smoke tests ===========================================================
SMOKE_POOL_ADDRESS=                # a PancakeSwap V3 pool to probe in T1
